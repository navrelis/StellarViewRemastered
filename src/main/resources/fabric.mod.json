{
	"schemaVersion": 1,
	"id": "stellarview",
	"version": "${version}",
	"name": "Stellar View Remastered",
	"description": "A maintained fork of Stellar View, a better night sky that keeps the Vanilla feeling. Adds a vanilla-like moon cycle, automatic hand-over of the sky to Iris shader packs, bug fixes and optimisations.",
	"authors": [
		"Woldericz_Junior (Povstalec) - original author",
		"navrelis - Remastered"
	],
	"contributors": [
		"Noobly Walker",
		"tehgreatdoge",
		"Erdragh",
		"tristankechlo"
	],
	"contact": {
		"homepage": "https://github.com/navrelis/StellarViewRemastered",
		"sources": "https://github.com/navrelis/StellarViewRemastered",
		"issues": "https://github.com/navrelis/StellarViewRemastered/issues"
	},
	"license": "MIT",
	"icon": "assets/stellarview/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [ "net.povstalec.stellarview.StellarView" ],
		"client": [ "net.povstalec.stellarview.StellarViewClient" ],
		"modmenu": [ "net.povstalec.stellarview.compatibility.modmenu.StellarViewModMenu" ]
	},
	"mixins": [
		"stellarview.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*"
	},
	"suggests": {
		"enhancedcelestials": "*",
		"lunar": ">=0.2.6"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.wiki": "https://moddedmc.wiki/cs/project/stellarview/docs"
			}
		}
	}
}